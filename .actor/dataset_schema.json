{
    "actorSpecification": 1,
    "title": "GEO & AI Readiness Audit Dataset",
    "description": "Dataset schema for website GEO and AI readiness audit results.",
    "fields": {
        "type": "object",
        "properties": {
            "url": {
                "type": "string",
                "title": "Input URL",
                "description": "Original URL submitted for auditing."
            },
            "finalUrl": {
                "type": "string",
                "title": "Final URL",
                "description": "Resolved destination URL after following redirects."
            },
            "geoScore": {
                "type": "number",
                "title": "GEO Score",
                "description": "Overall GEO and AI readiness score from 0 to 100."
            },
            "status": {
                "type": "string",
                "title": "Status",
                "description": "Audit execution status for this URL.",
                "enum": [
                    "ok",
                    "error"
                ]
            },
            "recommendations": {
                "type": "array",
                "title": "Recommendations",
                "description": "Actionable GEO and AI readiness improvements identified during the audit.",
                "items": {
                    "type": "string"
                }            
            },
            "auditedAt": {
                "type": "string",
                "title": "Audited At",
                "description": "UTC ISO-8601 timestamp of when the audit completed."
            }
        },
        "required": [
            "url",
            "status"
        ],
        "additionalProperties": true
    },
    "views": {
        "overview": {
            "title": "Overview",
            "description": "Summary table of GEO scores, status, and actionable recommendations for each audited website.",
            "transformation": {
                "fields": [
                    "finalUrl",
                    "geoScore",
                    "status",
                    "recommendations",
                    "auditedAt"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "finalUrl": {
                        "label": "Final URL",
                        "format": "link"
                    },
                    "geoScore": {
                        "label": "GEO Score",
                        "format": "number"
                    },
                    "status": {
                        "label": "Status",
                        "format": "text"
                    },
                    "recommendations": {
                        "label": "Recommendations",
                        "format": "array"
                    },
                    "auditedAt": {
                        "label": "Audited At",
                        "format": "date"
                    }
                }
            }
        }
    }
}
