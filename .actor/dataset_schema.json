{
    "actorSpecification": 1,
    "title": "GEO & AI Readiness Audit Dataset",
    "description": "Dataset schema for website GEO and AI readiness audit results.",
    "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "url": {
                "type": "string",
                "title": "Input URL",
                "description": "Original URL submitted for auditing.",
                "example": "https://apify.com"
            },
            "finalUrl": {
                "type": "string",
                "title": "Final URL",
                "description": "Resolved destination URL after following redirects.",
                "example": "https://apify.com/"
            },
            "geoScore": {
                "type": "number",
                "title": "GEO Score",
                "description": "Overall GEO and AI readiness score from 0 to 100.",
                "example": 100
            },
            "status": {
                "type": "string",
                "title": "Status",
                "description": "Audit execution status for this URL.",
                "enum": [
                    "ok",
                    "error"
                ],
                "example": "ok"
            },
            "recommendations": {
                "type": "array",
                "title": "Recommendations",
                "description": "Actionable GEO and AI readiness improvements identified during the audit.",
                "items": {
                    "type": "string"
                },
                "example": []
            },
            "auditedAt": {
                "type": "string",
                "title": "Audited At",
                "description": "UTC ISO-8601 timestamp of when the audit completed.",
                "example": "2026-11-22T15:00:00+00:00"
            }
        },
        "required": [
            "url",
            "status"
        ],
        "additionalProperties": true
    },
    "views": {
        "overview": {
            "title": "Overview",
            "description": "Summary table of GEO scores, status, and actionable recommendations for each audited website.",
            "transformation": {
                "fields": [
                    "finalUrl",
                    "geoScore",
                    "status",
                    "recommendations",
                    "auditedAt"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "finalUrl": {
                        "label": "Final URL",
                        "format": "link"
                    },
                    "geoScore": {
                        "label": "GEO Score",
                        "format": "number"
                    },
                    "status": {
                        "label": "Status",
                        "format": "text"
                    },
                    "recommendations": {
                        "label": "Recommendations",
                        "format": "array"
                    },
                    "auditedAt": {
                        "label": "Audited At",
                        "format": "date"
                    }
                }
            }
        }
    }
}
